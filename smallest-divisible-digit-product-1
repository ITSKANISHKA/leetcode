class Solution {
    public int smallestNumber(int n, int t) {
        for(int i= n ;i < n+10;i++){
            if(pro(i)%t==0){
                return i;
            }
        }return -1;
    }
    private int pro(int n){
        int prod = 1;
        while(n > 0){
            prod *= (n%10);
            n = n/10;
        }
            return prod;
    }
}
