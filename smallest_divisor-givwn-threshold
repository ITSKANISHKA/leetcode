class Solution {
    public int smallestDivisor(int[] nums, int threshold) {
        int n=nums.length;
        int l=1;
        int h=0;
        int ans=Integer.MAX_VALUE;
        for(int i=0;i<n;i++){
            h=Math.max(h,nums[i]);
        }
        while(l<=h){
            int mid=(h+l)/2;
            int s=0;
            for(int i:nums){
                if(i%mid!=0){
                    s+=1;
                }s+=(i/mid);
            }
            if(s<=threshold){
                ans=Math.min(ans,mid);
                h=mid-1;
            }else{
                l=mid+1;
            }
        }return ans;
    }
}
