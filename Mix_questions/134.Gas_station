class Solution {
    public int canCompleteCircuit(int[] gas, int[] cost) {
        int n=gas.length;
        int total=0;
        for(int j=0;j<n;j++){
            total+=gas[j]-cost[j];
        }if(total<0)return -1;
        // int i=0;
        // while(i>0){
        int curr=0;
        int idx=0;
        for(int i=0;i<n;i++){
            // if(gas[i]<cost[i]){
            //     i++;
            // }else if(gas[i]>cost[i]){
                curr+=gas[i]-cost[i];
            //     i++;
            //     gas[i]=gas[i]+gas[i-1];
            // }
            if(curr<0){
                curr=0;
                idx=i+1;
            }
        }return idx;
    }
}
