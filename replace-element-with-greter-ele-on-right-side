class Solution {
    public int[] replaceElements(int[] arr) {
        int n=arr.length;
        int max=arr[n-1];
        int[] res=new int[n];
        res[n-1]=-1;
        for(int i = n - 2; i >= 0; i--) {
            res[i] = max;
            if(arr[i] > max) {
                max = arr[i];
            }
        }
        return res;
    }
}
