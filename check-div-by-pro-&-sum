class Solution {
    public boolean checkDivisibility(int n) {
        int sum = 0;
        int product = 1;
        int proSum = 0;
        int real = n;
        while ( n > 0 ) {
            sum += n % 10;
            product = product * (n % 10);
            proSum = sum + product;
            
            n = n/10;
        }
        if ( real % proSum == 0) {
                return true;
            }
        return false;
    }
}
