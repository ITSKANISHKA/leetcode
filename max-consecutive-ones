class Solution {
    public int findMaxConsecutiveOnes(int[] nums) {
        int n=nums.length;
        int cnt=0;
        int re=0;
        for(int i=0;i<n;i++){
            if(nums[i]==0){
                cnt=0;
            }else {
                cnt++;
            }
            if(re<cnt){
                re=cnt;
            }
        }return re;
    }
}
