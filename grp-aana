class Solution {
    public List<List<String>> groupAnagrams(String[] strs) {
        HashMap<String,List<String>> mp=new HashMap<>();
        for(String s:strs){
            char[] ch=s.toCharArray();
            Arrays.sort(ch);
            String k=new String(ch);
            if(!mp.containsKey(k)){
                mp.put(k,new ArrayList<>());
            }mp.get(k).add(s);

        }return new ArrayList<>(mp.values());
        
    }
}
